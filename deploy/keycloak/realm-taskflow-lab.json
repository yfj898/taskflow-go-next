        {"name": "taskflow-groups", "protocol": "openid-connect", "protocolMapper": "oidc-hardcoded-claim-mapper", "config": {"claim.name": "groups", "claim.value": "[\"operators\"]", "jsonType.label": "JSON", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false"}},
        {"name": "taskflow-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": {"included.custom.audience": "taskflow-control-plane", "access.token.claim": "true", "id.token.claim": "false"}}
      ]
    },
    {
      "clientId": "taskflow-tenant-a-reader",
      "name": "TaskFlow team-a read-only workload identity",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "serviceAccountsEnabled": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "fullScopeAllowed": false,
      "protocolMappers": [
        {"name": "taskflow-tenant", "protocol": "openid-connect", "protocolMapper": "oidc-hardcoded-claim-mapper", "config": {"claim.name": "tenant_id", "claim.value": "team-a", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false"}},
        {"name": "taskflow-groups", "protocol": "openid-connect", "protocolMapper": "oidc-hardcoded-claim-mapper", "config": {"claim.name": "groups", "claim.value": "[\"readers\"]", "jsonType.label": "JSON", "access.token.claim": "true", "id.token.claim": "false", "userinfo.token.claim": "false"}},
        {"name": "taskflow-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": {"included.custom.audience": "taskflow-control-plane", "access.token.claim": "true", "id.token.claim": "false"}}
      ]
